#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset

# shellcheck disable=SC2012
folder="$(cd "$HOME/Developer" && ls -dt ./*/ 2>/dev/null | sed 's#^\./##' | fzf)"


if [ "${TERM_PROGRAM:-}" = "kitty" ]; then
    kitty @launch --type=tab --tab-title="$folder" --cwd="$HOME/Developer/$folder"
elif [ "${TERM_PROGRAM:-}" = "tmux" ]; then
    tmux new-window -c "$HOME/Developer/$folder"
else
    cd "$HOME/Developer/$folder"
    exec "$SHELL"
fi
