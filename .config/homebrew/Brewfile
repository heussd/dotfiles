def import(file)
  path = File.join(__dir__, file)
  instance_eval(File.read(path), path)
end

brew "git"
brew "fzf"	# Needed because apt version is too old for vimwiki
brew "ripgrep"	# Also needed for vim
brew "ag"
brew "btop"
brew "eza"
brew "lazydocker"
brew "lazygit"
brew "docker-compose"


kernelBrewfile = "Brewfile.#{OS.kernel_name.downcase}"
import kernelBrewfile if File.exist?(File.join(__dir__, kernelBrewfile))


require "socket"
hostname = Socket.gethostname.split(/[._-]/).first.downcase

hostBrewfile = "Brewfile.#{hostname}"
import hostBrewfile if File.exist?(File.join(__dir__, hostBrewfile))
